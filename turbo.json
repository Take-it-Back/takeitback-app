{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "SENTRY_*", "VERCEL_*", "ANTHROPIC_MODEL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": {},
    "lint": {},
    "dev": { "cache": false, "persistent": true }
  }
}
